# =============================================================================
# Корневой .env для docker-compose НЕ обязателен
# =============================================================================
# Секреты и настройки сервисов задаются в ЛОКАЛЬНЫХ файлах:
#   ./auth-service/.env
#   ./event-service/.env  (в т.ч. RABBITMQ_URL для приглашений в мероприятие)
#   ./user-service/.env
#   ./task-service/.env
#   ./resource-service/.env
#   ./notification-service/.env
#   ./ai-assistant/.env
#
# В docker-compose для каждого сервиса подключён env_file на соответствующий путь.
# В блоке environment остаётся только DATABASE_URL под сеть Docker (хост postgres_*).
#
# Важно: SECRET_KEY должен быть ОДИНАКОВЫМ во всех сервисных .env, где проверяется JWT.
# SERVICE_SECRET_AI в ai-assistant/.env должен совпадать со значением в auth-service/.env
# (см. auth-service: POST /api/auth/internal/token для service_name=ai-assistant).
# =============================================================================

# Ниже — пример переменных для локальной разработки ВНЕ Docker (по желанию).
# Для docker compose up используйте только env_file в подпапках сервисов.

REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://admin:admin_password@localhost:5672/

DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO
