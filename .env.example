# ========================================
# БАЗОВЫЕ НАСТРОЙКИ (НЕ МЕНЯЙТЕ)
# ========================================
DATABASE_URL_AUTH=postgresql://auth_user:auth_password@postgres-auth:5432/auth_db
DATABASE_URL_EVENTS=postgresql://event_user:event_password@postgres-events:5432/events_db
REDIS_URL=redis://redis-cache:6379/0
RABBITMQ_URL=amqp://admin:admin_password@rabbitmq:5672/

# ========================================
# JWT & SECURITY
# ========================================
SECRET_KEY=change-me-super-secret-key-for-jwt-32-characters-minimum!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080  # 1 неделя

# ========================================
# ПРИЛОЖЕНИЕ
# ========================================
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# ========================================
# AI ASSISTANT (позже настроим)
# ========================================
OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-3.5-turbo
